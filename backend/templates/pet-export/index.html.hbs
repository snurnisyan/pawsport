<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Медицинский отчет питомца Pawsport</title>
    <style>
      @page {
        size: A4;
        margin: 11mm 10mm;
      }

      :root {
        --paper: #ffffff;
        --ink: #232631;
        --muted: #687083;
        --subtle: #939bab;
        --line: #e3e6ee;
        --line-strong: #ccd2de;
        --brand: #6d3ee8;
        --brand-soft: #f0e9ff;
        --brand-line: #ddcffc;
        --panel: #fafbfe;
        --vac-bg: #f5f3ff;
        --vac-fg: #c084fc;
        --vet-bg: #eff6ff;
        --vet-fg: #60a5fa;
        --med-bg: #ecfdf5;
        --med-fg: #34d399;
        --sur-bg: #fff7ed;
        --sur-fg: #fb923c;
        --lab-bg: #fdf2f8;
        --lab-fg: #ef96d6;
        --oth-bg: #f1f5f9;
        --oth-fg: #64748b;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: #fff;
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        font-size: 11px;
        line-height: 1.4;
      }

      .page {
        background: var(--paper);
        min-height: 275mm;
      }

      .doc-head {
        align-items: center;
        border-bottom: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        padding-bottom: 9mm;
      }

      .brand {
        align-items: center;
        display: flex;
        gap: 8px;
      }

      .brand-mark {
        align-items: center;
        background: var(--brand);
        border-radius: 7px;
        color: #fff;
        display: flex;
        font-size: 13px;
        font-weight: 800;
        height: 24px;
        justify-content: center;
        width: 24px;
      }

      .brand-name {
        font-size: 14px;
        font-weight: 700;
      }

      .brand-name span {
        color: var(--muted);
        font-weight: 500;
        margin-left: 8px;
      }

      .doc-meta {
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        font-size: 11px;
        gap: 14px;
        justify-content: flex-end;
      }

      .doc-meta b {
        color: var(--ink);
        font-weight: 650;
      }

      .profile-card {
        break-inside: avoid;
        margin-top: 9mm;
        page-break-inside: avoid;
      }

      .profile-top {
        align-items: center;
        display: grid;
        gap: 18px;
        grid-template-columns: 96px 1fr;
      }

      .avatar {
        align-items: center;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #bba5ff 0%, #eda9f5 100%);
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 1px var(--line), 0 8px 18px rgba(109, 62, 232, 0.16);
        color: #fff;
        display: flex;
        font-size: 40px;
        font-weight: 800;
        justify-content: center;
        overflow: hidden;
        width: 96px;
      }

      .avatar img {
        height: 100%;
        object-fit: cover;
        width: 100%;
      }

      .profile-info { min-width: 0; }

      .species-tag {
        background: var(--brand-soft);
        border-radius: 999px;
        color: var(--brand);
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 5px;
        padding: 3px 10px;
      }

      .pet-name {
        font-size: 29px;
        letter-spacing: 0;
        line-height: 1.08;
        margin: 0 0 7px;
      }

      .summary-list {
        align-items: center;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 5px 10px;
      }

      .summary-item strong {
        color: var(--ink);
        font-weight: 650;
      }

      .summary-dot {
        background: var(--subtle);
        border-radius: 50%;
        height: 3px;
        width: 3px;
      }

      .summary-chip {
        background: #f6f7fb;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        display: inline-block;
        max-width: 100%;
        overflow-wrap: anywhere;
        padding: 2px 8px;
      }

      .notes-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        margin-top: 10px;
        padding: 10px 12px;
      }

      .subhead {
        color: var(--muted);
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 0 0 5px;
        text-transform: uppercase;
      }

      .notes-list {
        margin: 0;
        padding-left: 16px;
      }

      .notes-list li { margin: 0 0 3px; }
      .notes-list li:last-child { margin-bottom: 0; }

      .section-head {
        align-items: baseline;
        display: flex;
        justify-content: space-between;
        margin: 10mm 0 5mm;
      }

      .section-title {
        font-size: 19px;
        line-height: 1.1;
        margin: 0;
      }

      .section-sub {
        color: var(--muted);
        font-size: 11px;
      }

      .section-sub b { color: var(--ink); }

      .timeline {
        position: relative;
      }

      .tl-event {
        break-inside: avoid;
        display: grid;
        gap: 12px;
        grid-template-columns: 34px 1fr;
        margin-bottom: 8px;
        page-break-inside: avoid;
        -webkit-column-break-inside: avoid;
      }

      .tl-event::before {
        background: var(--line-strong);
        content: "";
        grid-column: 1;
        grid-row: 1;
        height: calc(100% + 8px);
        justify-self: center;
        width: 2px;
      }

      .tl-event:last-child::before { height: 100%; }

      .tl-icon {
        align-items: center;
        align-self: start;
        border: 2px solid currentColor;
        border-radius: 50%;
        display: flex;
        grid-column: 1;
        grid-row: 1;
        height: 34px;
        justify-content: center;
        justify-self: center;
        position: relative;
        width: 34px;
        z-index: 1;
      }

      .tl-icon svg { height: 15px; width: 15px; }
      .vac { background: var(--vac-bg); color: var(--vac-fg); }
      .vet { background: var(--vet-bg); color: var(--vet-fg); }
      .med { background: var(--med-bg); color: var(--med-fg); }
      .sur { background: var(--sur-bg); color: var(--sur-fg); }
      .lab { background: var(--lab-bg); color: var(--lab-fg); }
      .oth { background: var(--oth-bg); color: var(--oth-fg); }

      .tl-event.future .tl-icon { background: #fff; }

      .tl-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        grid-column: 2;
        grid-row: 1;
        min-width: 0;
        padding: 10px 12px;
      }

      .tl-event.future .tl-card {
        background: linear-gradient(180deg, #fbf8ff 0%, #fff 100%);
        border-color: var(--brand-line);
      }

      .tl-card-head {
        align-items: flex-start;
        display: flex;
        gap: 10px;
        justify-content: space-between;
        margin-bottom: 3px;
      }

      .tl-date {
        color: var(--muted);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .tl-type {
        border-radius: 999px;
        flex: 0 0 auto;
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.07em;
        padding: 2px 8px;
        text-transform: uppercase;
      }

      .tl-title {
        font-size: 13.5px;
        font-weight: 750;
        line-height: 1.25;
        margin-bottom: 2px;
      }

      .tl-context {
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 4px 8px;
      }

      .tl-comment {
        background: var(--panel);
        border-left: 3px solid var(--line-strong);
        border-radius: 0 6px 6px 0;
        margin-top: 7px;
        padding: 6px 9px;
      }

      .tl-extras {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 7px;
      }

      .file-chip {
        align-items: center;
        background: #f6f7fb;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        display: inline-flex;
        font-size: 10.5px;
        gap: 5px;
        max-width: 100%;
        overflow-wrap: anywhere;
        padding: 2px 8px;
        text-decoration: none;
      }

      .file-chip[href] { color: #2454b8; }
      .file-chip svg { flex: 0 0 auto; height: 11px; width: 11px; }

      .file-table {
        border-collapse: collapse;
        margin-top: 5mm;
        width: 100%;
      }

      .file-table th,
      .file-table td {
        border-bottom: 1px solid var(--line);
        padding: 5px 6px;
        text-align: left;
        vertical-align: top;
      }

      .file-table th {
        color: var(--muted);
        font-size: 9.5px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .file-table a { color: #2454b8; text-decoration: none; }

      .doc-foot {
        border-top: 1px solid var(--line);
        color: var(--subtle);
        display: flex;
        font-size: 9.5px;
        justify-content: space-between;
        margin-top: 10mm;
        padding-top: 5mm;
      }

      @media print {
        .tl-event { break-inside: avoid-page; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="doc-head">
        <div class="brand">
          <span class="brand-mark">P</span>
          <span class="brand-name">Pawsport <span>Медицинский отчет</span></span>
        </div>
        <div class="doc-meta">
          <span><b>Период</b> {{report.periodLabel}}</span>
          <span><b>Создан</b> {{report.generatedLabel}}</span>
        </div>
      </header>

      {{#if profile}}
        <section class="profile-card">
          <div class="profile-top">
            <div class="avatar">
              {{#if profile.photo}}
                <img src="{{{profile.photo.src}}}" alt="{{profile.name}}" />
              {{else}}
                {{profile.initial}}
              {{/if}}
            </div>
            <div class="profile-info">
              {{#if profile.speciesLabel}}<div class="species-tag">{{profile.speciesLabel}}</div>{{/if}}
              <h1 class="pet-name">{{profile.name}}</h1>
              <div class="summary-list">
                {{#each profile.summaryParts}}
                  {{#unless @first}}<span class="summary-dot"></span>{{/unless}}
                  <span class="summary-item summary-chip">{{this}}</span>
                {{/each}}
              </div>
            </div>
          </div>
          {{#if profile.notes}}
            <div class="notes-card">
              <p class="subhead">Заметки владельца</p>
              <ul class="notes-list">
                {{#each profile.notes}}<li>{{this}}</li>{{/each}}
              </ul>
            </div>
          {{/if}}
        </section>
      {{/if}}

      {{#if events}}
        <section>
          <div class="section-head">
            <h2 class="section-title">История ухода</h2>
            <div class="section-sub">
              Прошло: <b>{{counts.pastEvents}}</b> &middot;
              Запланировано: <b>{{counts.futureEvents}}</b> &middot;
              Документы: <b>{{counts.files}}</b>
            </div>
          </div>

          <div class="timeline">
            {{#each events}}
              <article class="tl-event {{stateClass}}">
                <div class="tl-icon {{typeClass}}">
                  {{{typeIconSvg}}}
                </div>
                <div class="tl-card">
                  <div class="tl-card-head">
                    <span class="tl-date">{{dateLabel}}</span>
                    <span class="tl-type {{typeClass}}">{{typeLabel}}</span>
                  </div>
                  <div class="tl-title">{{title}}</div>
                  {{#if contextParts}}
                    <div class="tl-context">
                      {{#each contextParts}}
                        {{#unless @first}}<span>&middot;</span>{{/unless}}
                        <span>{{this}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                  {{#if comment}}<div class="tl-comment">{{comment}}</div>{{/if}}
                  {{#if files}}
                    <div class="tl-extras">
                      {{#each files}}
                        <a class="file-chip" href="{{downloadUrl}}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>
                          <span>{{originalName}} &middot; {{sizeLabel}}</span>
                        </a>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if renderFilesSection}}
        <section>
          <div class="section-head">
            <h2 class="section-title">Документы</h2>
            <div class="section-sub">Файлы: <b>{{counts.documentFiles}}</b></div>
          </div>
          <table class="file-table">
            <thead>
              <tr>
                <th>Название</th>
                <th>Загружен</th>
                <th>Размер</th>
                <th>Событие</th>
              </tr>
            </thead>
            <tbody>
              {{#each documentFiles}}
                <tr>
                  <td><a href="{{downloadUrl}}">{{originalName}}</a></td>
                  <td>{{uploadedLabel}}</td>
                  <td>{{sizeLabel}}</td>
                  <td>{{eventTitle}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </section>
      {{/if}}

      <footer class="doc-foot">
        <span>Pawsport: медицинский отчет питомца</span>
        <span>ID отчета {{report.exportId}}</span>
      </footer>
    </main>
  </body>
</html>
