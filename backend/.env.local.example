NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000

MONGODB_URI=mongodb://localhost:27017/pawsport-local

JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=7d

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local-user
SMTP_PASSWORD=local-password
SMTP_FROM=no-reply@localhost

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=pawsport-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key

REMINDER_SCHEDULER_ENABLED=false
REMINDER_POLL_INTERVAL_MS=60000

BACKGROUND_JOB_RUNNER_ENABLED=false
BACKGROUND_JOB_POLL_INTERVAL_MS=5000
BACKGROUND_JOB_CONCURRENCY=2
BACKGROUND_JOB_VISIBILITY_TIMEOUT_MS=60000
BACKGROUND_JOB_DEFAULT_MAX_ATTEMPTS=5

GOTENBERG_URL=http://localhost:3001
GOTENBERG_TIMEOUT_MS=60000

SWAGGER_ENABLED=true
