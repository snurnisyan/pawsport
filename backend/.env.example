NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/pawsport

JWT_SECRET=replace-with-secure-secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=replace-with-bucket-name
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key

REMINDER_SCHEDULER_ENABLED=false
REMINDER_POLL_INTERVAL_MS=60000
